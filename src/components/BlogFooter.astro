---
import { getCollection } from 'astro:content';

interface Props {
  currentSlug: string;
  githubRepo?: string;
}

const { currentSlug, githubRepo } = Astro.props;

// Astro v6's glob loader uses `id` for routing paths rather than `slug`.
const keepReading = (await getCollection('blog'))
  .filter((post) => post.id !== currentSlug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<footer class="blogFooter">
  <section class="win win--titled author">
    <span class="win__t">~/author</span>

    <img
      class="portrait"
      src="/headshot_carlos-lorenzo-zuniga-mari.jpg"
      alt="Carlos Lorenzo-Zúñiga Marí"
      width="72"
      height="72"
      loading="lazy"
    />

    <div class="authorBody">
      <h3 class="name">Carlos Lorenzo-Zúñiga Marí</h3>
      <p class="bio">
        BME student, self-taught developer and systems architect. I work on
        neurotechnology, machine learning, and the hardware that sits underneath both.
      </p>

      <dl class="kv links">
        {githubRepo && (
          <div class="row">
            <dt>source</dt>
            <dd><a href={githubRepo} target="_blank" rel="noopener noreferrer">repo for this post</a></dd>
          </div>
        )}
        <div class="row">
          <dt>contact</dt>
          <dd>
            <a href="https://www.linkedin.com/in/carloslorenzozunigamari/" target="_blank" rel="noopener noreferrer">
              linkedin
            </a>
          </dd>
        </div>
        <div class="row">
          <dt>more</dt>
          <dd><a href="/">full portfolio</a></dd>
        </div>
      </dl>
    </div>
  </section>

  {keepReading.length > 0 && (
    <section class="next">
      <h3 class="t-rule"><span>keep reading</span></h3>
      <ul class="tree tree--tight">
        {keepReading.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="nextLink">
              <span class="nextTitle">{post.data.title}</span>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <p class="colophon">
    © {new Date().getFullYear()} Carlos Lorenzo — built from scratch with Astro
  </p>
</footer>

<style>
  .blogFooter { margin-top: var(--space-7); }

  .author {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  .portrait {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    border: 1px solid var(--border);
    filter: grayscale(1);
  }

  .authorBody { min-width: 0; }

  .name {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--t-body);
    font-weight: 700;
    color: var(--fg);
  }

  .bio {
    max-width: 58ch;
    margin: 0 0 var(--space-4);
    font-family: var(--font-prose);
    font-size: var(--t-small);
    line-height: 1.65;
    color: var(--fg-dim);
  }

  .links { font-size: var(--t-small); }
  .links dt {
    font-style: italic;
    font-weight: 700;
    color: var(--fg-faint);
  }
  .links a { color: var(--purple); }
  .links a:hover { color: var(--pink); }
  .row { display: grid; grid-template-columns: subgrid; grid-column: span 2; }

  .next { margin-bottom: var(--space-6); }

  .nextLink {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    color: var(--fg);
  }
  .nextTitle { font-family: var(--font-mono); font-size: var(--t-small); font-weight: 700; }
  .nextLink:hover .nextTitle { color: var(--accent); }
  .nextLink time {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .colophon {
    margin: 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--fg-faint);
  }

  @media (max-width: 640px) {
    .author { grid-template-columns: minmax(0, 1fr); }
  }
</style>
