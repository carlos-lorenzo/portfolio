---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { readingTime } from '../../lib/readingTime';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Grouped by year, newest first — the year becomes the section rule and each
// post hangs off it as a tree child.
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const y = post.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(post);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://carloslorenzo.dev' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://carloslorenzo.dev/blog' },
  ],
};
---

<Layout
  title="Blog | Carlos Lorenzo-Zúñiga Marí"
  description="Research and technical deep-dives on neurotechnology, ML, and systems by Carlos Lorenzo-Zúñiga Marí."
  keywords={['Blog', 'Neurotechnology', 'Machine Learning', 'System Engineering']}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <a class="skip-link" href="#posts">Skip to posts</a>

  <main class="shell" id="top">
    <header class="head">
      <a href="/" class="back"><span aria-hidden="true">←</span> portfolio</a>

      <span class="path">/blog</span>
      <div class="titleRow">
        <h1 class="t-h1">Technical Weblog</h1>
        <a href="/rss.xml" class="rss" aria-label="RSS feed">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"/></svg>
          rss
        </a>
      </div>
      <p class="lede">
        Engineering notes on biosignals, hardware design and low-level systems.
      </p>
    </header>

    <div id="posts">
      {posts.length === 0 && <p class="empty">No posts yet — check back soon.</p>}

      {years.map((year) => (
        <section class="year">
          <h2 class="t-rule"><span>{year}</span></h2>

          <ul class="tree">
            {byYear.get(year)!.map((post) => (
              <li>
                <a href={`/blog/${post.id}`} class="entry">
                  <span class="entryTop">
                    <time class="date" datetime={post.data.date.toISOString()}>
                      {post.data.date.toLocaleDateString('en-US', { month: '2-digit', day: '2-digit' }).replace('/', '-')}
                    </time>
                    <span class="title">{post.data.title}</span>
                    <span class="read">{readingTime(post)}</span>
                  </span>

                  <span class="desc">{post.data.description}</span>

                  {post.data.tags?.length > 0 && (
                    <span class="tags">
                      {post.data.tags.slice(0, 4).map((tag: string) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

  <nav class="actions" aria-label="Primary actions">
    <a href="/"><span aria-hidden="true">←</span> Portfolio</a>
    <a href="#top"><span aria-hidden="true">↑</span> Top</a>
    <a href="/rss.xml"><span aria-hidden="true">◉</span> RSS</a>
  </nav>
</Layout>

<style>
  .shell {
    --accent: var(--cyan);
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-7) var(--space-4);
  }

  .head {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .back {
    display: inline-block;
    margin-bottom: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--fg-dim);
  }
  .back:hover { color: var(--pink); }

  .titleRow {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin: var(--space-2) 0 var(--space-3);
  }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--fg-dim);
  }
  .rss:hover { color: var(--orange); border-color: var(--orange); }

  .lede {
    max-width: var(--measure);
    margin: 0;
    font-family: var(--font-prose);
    font-size: var(--t-lead);
    color: var(--fg-dim);
  }

  .year { margin-bottom: var(--space-6); }
  .year:last-child { margin-bottom: 0; }

  /* The whole row is the link, which is what makes a hover state legitimate
     here. Colour and background only — nothing moves. */
  .entry {
    display: block;
    margin: calc(-1 * var(--space-2)) 0 0 calc(-1 * var(--space-2));
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    color: inherit;
  }
  .entry:hover { background: var(--bg-hover); }

  .entryTop {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .date {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    font-variant-numeric: tabular-nums;
    color: var(--fg-faint);
  }

  .title {
    font-family: var(--font-mono);
    font-size: var(--t-body);
    font-weight: 700;
    color: var(--fg);
    line-height: 1.4;
  }
  .entry:hover .title { color: var(--accent); }

  .read {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--track);
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .desc {
    display: block;
    max-width: 66ch;
    margin-top: var(--space-1);
    padding-left: 3.5rem;
    font-family: var(--font-prose);
    font-size: var(--t-small);
    line-height: 1.6;
    color: var(--fg-dim);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: var(--space-2);
    padding-left: 3.5rem;
  }

  .empty { color: var(--fg-dim); }

  @media (max-width: 880px) {
    .shell { padding: var(--space-5) var(--space-3) var(--space-6); }
  }

  @media (max-width: 640px) {
    .read { margin-left: 0; }
    .desc, .tags { padding-left: 0; }
  }
</style>
